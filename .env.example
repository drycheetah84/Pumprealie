# ───────────────────────────────────────────────────────────────────────────────
# Pumpraelie configuration. Copy to `.env` and adjust. Never commit `.env`.
# Every variable is optional unless marked REQUIRED; defaults are shown.
# ───────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | production | test
LOG_LEVEL=info                      # trace | debug | info | warn | error
LOG_FILE=./data/logs/pumpraelie.log # optional; logs always go to stdout too
DATA_DIR=./data                     # database, generated dashboard token, logs
# DATABASE_PATH=./data/pumpraelie.db  # defaults to $DATA_DIR/pumpraelie.db (SQLite, WAL mode)

# ── Solana RPC ─────────────────────────────────────────────────────────────────
# The public endpoint works for paper trading but rate-limits heavy calls
# (holder lists). For live trading use a dedicated provider (Helius, Triton,
# QuickNode, …). RPC URLs often embed API keys: they are never returned by the API.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_WS_URL=wss://api.mainnet-beta.solana.com   # derived from SOLANA_RPC_URL if unset
# SOLANA_RPC_BACKUP_URL=                            # optional failover endpoint
# SOLANA_WS_BACKUP_URL=
RPC_MAX_RPS=8                       # client-side rate limit for RPC calls
RPC_TIMEOUT_MS=10000
ONCHAIN_STREAM_ENABLED=true         # logsSubscribe on the Pump program (primary market data)

# ── Market data providers ──────────────────────────────────────────────────────
PUMPPORTAL_ENABLED=true             # wss://pumpportal.fun/api/data — new tokens + migrations (free)
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
# PUMPPORTAL_API_KEY=               # optional: enables PumpPortal per-token trade stream (paid tier)
DEXSCREENER_ENABLED=true            # https://api.dexscreener.com (public, no key)
DEXSCREENER_BASE_URL=https://api.dexscreener.com

# ── Dashboard / API ────────────────────────────────────────────────────────────
API_HOST=127.0.0.1                  # bind to localhost; see SECURITY.md before changing
API_PORT=8787
# REQUIRED in production (≥32 chars). Generate: openssl rand -base64 36
# In development, if unset, a random token is generated into $DATA_DIR/dashboard-token.
# This is a dashboard credential only — it is unrelated to the wallet.
# DASHBOARD_API_TOKEN=
CORS_ORIGINS=                       # comma-separated allowed origins; empty = same-origin only
API_RATE_LIMIT_PER_MIN=240

# ── Trading mode & wallet ──────────────────────────────────────────────────────
TRADING_MODE=paper                  # paper | offline   (live can only be armed from the dashboard)
LIVE_TRADING_ENABLED=false          # hard gate: live arming is impossible unless true
# Path to a solana-keygen JSON keypair for a DEDICATED trading wallet (chmod 600).
# The secret never leaves this machine; see SECURITY.md → "Wallet setup".
# WALLET_KEYPAIR_PATH=/secure/path/pumpraelie-trading.json
# WALLET_PUBLIC_KEY=                # optional: refuse to start live signing if the keypair differs
MIN_PAPER_TRADES_FOR_LIVE=20        # closed paper trades required before live can be armed

# ── Capital & risk defaults (runtime-editable, clamped to HARD_* below) ───────
TRADING_CAPITAL_SOL=1
MAX_POSITION_PCT=1                  # % of trading capital per position
MAX_EXPOSURE_PCT=10                 # % of capital across all open positions
MAX_DAILY_LOSS_PCT=3                # % of the day's starting equity (UTC day)
MAX_DRAWDOWN_PCT=5                  # suspend new entries at this drawdown from peak equity
MAX_SLIPPAGE_PCT=3
MAX_PRICE_IMPACT_PCT=3              # entry and exit impact (fees excluded)
MIN_EXIT_LIQUIDITY_SOL=5            # withdrawable SOL on the curve/pool
MAX_RISK_SCORE=44                   # 0-100 heuristic score; ≥45 is the "high" tier
MIN_EXPECTED_NET_RETURN_PCT=3       # scenario-weighted, after all costs
MIN_REWARD_TO_RISK=1.5
MAX_CONSECUTIVE_LOSSES=5
FEE_RESERVE_SOL=0.02                # never spent on positions
PRIORITY_FEE_MICROLAMPORTS=100000   # compute-unit price
COMPUTE_UNIT_LIMIT=250000
MAX_TX_FEE_SOL=0.002                # per transaction (base + priority)
EMERGENCY_POLICY=reduce             # reduce | hold — action when loss/drawdown limits are breached
ENABLED_STRATEGIES=momentum,volume_acceleration,pullback   # + early_launch (stricter, opt-in)

# ── Hard limits (execution layer; cannot be raised from the dashboard) ────────
HARD_MAX_POSITION_SOL=0.05
HARD_MAX_POSITION_PCT=5
HARD_MAX_EXPOSURE_PCT=25
HARD_MAX_DAILY_LOSS_PCT=10
HARD_MAX_DRAWDOWN_PCT=15
HARD_MAX_SLIPPAGE_PCT=10
HARD_MAX_RISK_SCORE=64

# ── Paper trading simulator ────────────────────────────────────────────────────
PAPER_LATENCY_MS=800                # decision → inclusion delay (market moves meanwhile)
PAPER_FAILURE_RATE=0.03             # random dropped/reverted transactions (fee still charged)

# ── Data retention & engine ────────────────────────────────────────────────────
RECORD_ALL_TRADES=true              # record every SOL-quoted Pump trade for backtesting
RETENTION_RAW_TRADES_HOURS=48       # raw trades (≈2-4M rows/day at current Pump volume)
RETENTION_CANDLES_DAYS=30           # 1-minute candles and token snapshots
RETENTION_ASSESSMENTS_DAYS=14       # assessments referenced by approved decisions are kept
MAX_TRACKED_TOKENS=3000
STALE_DATA_MS=20000                 # market data older than this blocks new entries
EVALUATION_INTERVAL_MS=3000
