{
  "name": "pumpraelie",
  "version": "1.0.0",
  "description": "Pumpraelie — risk-first autonomous Pump.fun trading agent (paper trading by default)",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite --config src/web/vite.config.ts",
    "start": "node dist/server/server/index.js",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build --config src/web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:integration": "PUMPRAELIE_INTEGRATION=1 vitest run tests/integration",
    "migrate": "tsx src/server/cli/migrate.ts",
    "backtest": "tsx src/server/cli/backtest.ts",
    "kill-switch": "tsx src/server/cli/killSwitch.ts",
    "wallet:check": "tsx src/server/cli/walletCheck.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drycheetah84/Pumprealie.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/drycheetah84/Pumprealie/issues"
  },
  "homepage": "https://github.com/drycheetah84/Pumprealie#readme",
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "@pump-fun/pump-sdk": "^4.3.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/web3.js": "^1.99.0",
    "better-sqlite3": "^13.0.3",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
